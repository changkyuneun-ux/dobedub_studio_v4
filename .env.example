WORKFLOWS_DIR=./workflows
WORKFLOW_SEED_DIR=./workflows
STUDIO_DATA_DIR=./data
METADATA_DIR=./metadata
OUTPUTS_DIR=./data/outputs
DATABASE_URL=mysql+pymysql://dobedub:dobedub_password@127.0.0.1:3306/dobedub_studio
DATABASE_ECHO=0
DATABASE_SSL_CA=
DATABASE_SSL_VERIFY_IDENTITY=0
PERSISTENCE_BACKEND=json
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=dobedub-studio
RUNPOD_DRY_RUN=1
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id
RUNPOD_BASE_URL=https://api.runpod.ai/v2
RUNPOD_TIMEOUT=30
TASK_MONITOR_INTERVAL_SECONDS=5
# Request timing logs are emitted as CloudWatch Embedded Metric Format JSON in ECS.
# Use `production` in the ECS task definition and inspect `DOBEDUB/Studio` metrics.
OBSERVABILITY_ENABLED=1
OBSERVABILITY_ENVIRONMENT=local
OBSERVABILITY_SLOW_REQUEST_MS=500
# Dedicated RunPod Pod for sandbox access only. Do not reuse Serverless values above.
# Use a dedicated Network Volume as the stable Sandbox selector across Pod migration.
RUNPOD_SANDBOX_NETWORK_VOLUME_ID=
# Optional secondary selector. Recommended when the Pod was deployed from a template.
# Use the template ID returned by the RunPod Pods API, not the human-readable template name.
RUNPOD_SANDBOX_TEMPLATE_ID=
# Required to deploy a new Pod after a stopped Pod cannot be resumed on its former host.
RUNPOD_SANDBOX_GPU_TYPE_ID=NVIDIA GeForce RTX 5090
RUNPOD_SANDBOX_GPU_COUNT=1
RUNPOD_SANDBOX_DEPLOY_NAME=dobedub_comfyUI_Sandbox
# Legacy name-prefix fallback. Pod migration may alter the name, so do not use as the primary selector.
RUNPOD_SANDBOX_POD_NAME=
# Legacy ID fallback only. Do not rely on this value after Pod migration.
RUNPOD_SANDBOX_POD_ID=
RUNPOD_SANDBOX_POD_API_KEY=
RUNPOD_SANDBOX_POD_REST_URL=https://rest.runpod.io/v1
# Runtime CPU, memory, and GPU utilization source for the Sandbox status view.
RUNPOD_SANDBOX_POD_GRAPHQL_URL=https://api.runpod.io/graphql
# Optional: a RunPod key with GraphQL read permission. When omitted, the Sandbox
# Pod API key is used. Keep it separate when the Pod-control key is REST-only.
RUNPOD_SANDBOX_POD_GRAPHQL_API_KEY=
RUNPOD_SANDBOX_POD_TIMEOUT=20
AUTH_JWT_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL_MINUTES=480
PROMPT_LLM_PROVIDER=mock
PROMPT_LLM_API_KEY=
PROMPT_LLM_ENDPOINT_ID=your_qwen_runpod_endpoint_id
PROMPT_LLM_ENDPOINT_URL=
PROMPT_LLM_MODEL=
PROMPT_LLM_RUNPOD_INPUT_MODE=prompt
PROMPT_LLM_TEMPERATURE=0.2
PROMPT_LLM_MAX_TOKENS=900
PROMPT_LLM_TIMEOUT=240
# Native RunPod Serverless: submit /run quickly, then persistently poll
# /status/{jobId}. This avoids treating a normal cold start as a failed prompt.
PROMPT_LLM_RUNPOD_EXECUTION_MODE=async
PROMPT_LLM_SUBMIT_TIMEOUT=20
PROMPT_LLM_COLD_START_TIMEOUT=900
PROMPT_LLM_POLL_INTERVAL=3
# Retry schedule for transient RunPod Qwen cold-start responses (502/503/504).
PROMPT_LLM_COLD_START_RETRY_DELAYS_SECONDS=5,10,20,30,30
# Grok image-to-video positive prompt generation. This path is separate from
# the legacy Qwen Prompt Builder values above.
GROK_ENABLED=0
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning
# Grok 호출은 업로드 후 사용자가 슬롯별 "프롬프트 생성"을 눌렀을 때만 시작됩니다.
GROK_AUTO_GENERATE_ON_UPLOAD=0
GROK_MAX_IMAGE_BYTES=20971520
GROK_MAX_OUTPUT_TOKENS=600
GROK_TEMPERATURE=0.2
GROK_REQUEST_TIMEOUT_SECONDS=120
# Retries apply only to temporary upstream failures (429/5xx/network timeout).
GROK_MAX_RETRIES=2
GROK_RETRY_BACKOFF_SECONDS=2
# Optional override. Empty uses $STUDIO_DATA_DIR/grok_instruction_set.json.
# This JSON is the canonical editable Grok instruction set; it replaces the
# former grok_instruction_documents database implementation.
GROK_INSTRUCTION_SET_PATH=
PORT=8787
RUN_SERVER_AUTO_MIGRATE=0
RUN_SERVER_SKIP_ENV_LOAD=0
